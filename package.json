{
  "name": "stirrup",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx src/main.ts --dev",
    "check": "tsc --noEmit",
    "build": "npm run check && tsc -p tsconfig.server.json && node scripts/copy-migrations.mjs && vite build",
    "preview": "node dist/server/src/main.js",
    "test": "node --import tsx --test test/*.test.ts",
    "smoke:agy": "node --import tsx test/smoke-dsh.ts --agent=agy",
    "smoke:dsh": "node --import tsx test/smoke-dsh.ts",
    "storage:migrate": "node --import tsx src/storage/cli.ts",
    "storage:export": "node --import tsx src/storage/cli.ts --export",
    "start": "node dist/server/src/main.js"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "overrides": {
    "undici": "8.12.2",
    "fflate": "0.8.3",
    "@modelcontextprotocol/client": "2.3.0"
  },
  "dependencies": {
    "@agentclientprotocol/codex-acp": "2.9.0",
    "@agentclientprotocol/sdk": "2.9.1",
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "ws": "8.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "jsdom": "31.0.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
