# Single local user. Run npm run passkey:setup to generate these values.
# The private key stays with your authenticator; never put a private key here.
STIRRUP_PASSKEY_USER_ID=
STIRRUP_PASSKEY_USER_NAME=
# Single-line JSON: {"id":"base64url","publicKey":"COSE-base64url","counter":0,"transports":["internal"]}
# Written only after successful WebAuthn registration; updated after authentication.
STIRRUP_PASSKEY_CREDENTIAL=

# Login session lifetime in seconds (1..31536000); default 43200 = 12 hours.
# Read on each successful login; existing sessions keep their original expiry.
STIRRUP_SESSION_TTL_SECONDS=43200
