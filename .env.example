# Web dev/preview listener; restart after changing these values.
# Host: IP or hostname, including 0.0.0.0 / ::. Port: integer 1..65535.
# An occupied port fails startup; it never falls back to another port.
STIRRUP_HOST=127.0.0.1
STIRRUP_PORT=5173

# Browser-facing origin, independent of Node's listener (restart required).
# With Nginx: STIRRUP_SITE_URL=https://chat.example.com
# Include an external non-default port, e.g. https://chat.example.com:8443
# If omitted, defaults to http://localhost:<actual listener port> for development.
# No path, query, fragment, credentials or IP-based RP ID.
# STIRRUP_SITE_URL=http://localhost:5173

# Passkey identity/public credential, login lifetime and personal appearance are in
# SQLite personal_settings. An empty table enables first-use Passkey initialization.
# Private keys always stay in the authenticator; legacy .env account fields are ignored.
